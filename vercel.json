{
  "functions": {
    "api/index.js": {
      "includeFiles": "{*.png,*.jpg,*.mp3,*.css,*.js,*.html}"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
